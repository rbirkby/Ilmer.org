---
pagination:
  data: collections.ilmerParishMeetingSubjects
  size: 1
  alias: subject
  addAllPagesToCollections: true
permalink: "/parish/ilmerparishmeeting/subject/{{ subject.tag }}/"
layout: post
category: history
tags: []
breadcrumbUseDate: false
headerUseDate: false
headerUseSubject: true
eleventyComputed:
  title: "Ilmer Parish Meeting Minutes: {{ subject.tag | subjectLabel | capitalize }}"
  subjectHeading: "{{ subject.tag | subjectLabel }}"
  description: "Ilmer Parish Meeting minutes concerning {{ subject.tag | subjectLabel }}."
---

<ul class="subject-list">
  {%- for item in subject.items -%}
    <li>
      <span class="subject-list__date">
        {% render "icons/calendar.liquid" %}
        {{ item.date | date: "%-d %b %Y" }}
      </span>
      <span class="subject-list__summary">{{ item.data.summary }}</span>
      <a class="subject-list__link" href="{{ item.url }}">Read minutes
        <span aria-hidden="true">&rarr;</span>
      </a>
    </li>
  {%- endfor -%}
</ul>