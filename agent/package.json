{
  "name": "ilmer-poppy",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Ilmer history agent (Pi Durable) with a Poppy endpoint, served at poppy.ilmer.org",
  "scripts": {
    "corpus": "node scripts/build-corpus.mjs",
    "dev": "ILMER_POPPY_LOCAL=true cf dev",
    "build": "vite build",
    "check": "tsc --noEmit && tsc --noEmit -p client/tsconfig.json",
    "test": "node --test tests/*.test.mjs",
    "deploy:dry-run": "cf deploy --dry-run",
    "deploy": "cf deploy"
  },
  "dependencies": {
    "@cloudflare/kumo": "^2.14.0",
    "@earendil-works/pi-ai": "^1.1.0",
    "@earendil-works/pi-durable": "^1.1.0",
    "@phosphor-icons/react": "^2.1.10",
    "agents": "^0.28.0",
    "jose": "^6.2.12",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "streamdown": "^2.7.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^2.0.0-beta.sha-91c870c02",
    "@cloudflare/workers-types": "^5.20261010.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "cf": "^1.0.0-beta.14",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261006.1": true
  },
  "overrides": {
    "@modelcontextprotocol/client": "^2.3.1",
    "@modelcontextprotocol/sdk": "^1.32.1"
  }
}
