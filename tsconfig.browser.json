{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "lib": ["esnext", "dom", "dom.iterable"],
    "types": [],
    "strict": true,
    "paths": {
      "/assets/*": ["./assets/*"]
    }
  },
  "include": ["assets/js/**/*.ts", "types/browser-globals.d.ts", "types/vite-modules.d.ts"],
  "exclude": ["node_modules", "_site", "assets/dist"]
}
