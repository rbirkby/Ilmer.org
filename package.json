{
  "name": "ilmer-org",
  "version": "1.0.0",
  "description": "Ilmer Past - local history website",
  "private": true,
  "scripts": {
    "start": "npx @11ty/eleventy --serve",
    "build": "npx @11ty/eleventy",
    "format": "oxfmt --write .",
    "format-check": "oxfmt --check .",
    "lint": "oxlint && markdownlint --ignore node_modules '**/*.md' --config .markdownlintrc.json --fix",
    "lint-check": "oxlint && markdownlint --ignore node_modules '**/*.md' --config .markdownlintrc.json",
    "lint:events": "node scripts/check-events.mjs",
    "link-check": "linkinator _site --recurse --verbosity error --status-code '401:warn' --status-code '403:warn' --status-code '429:warn'",
    "link-check:internal": "node scripts/check-links-internal.mjs _site",
    "a11y": "node scripts/check-a11y-pour.mjs _site",
    "lighthouse": "lhci autorun",
    "test": "node --run format-check && node --run lint-check && node --run lint:events && node --run build"
  },
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "keywords": [],
  "author": "Richard Birkby <rbirkby@gmail.com>",
  "license": "MIT",
  "devDependencies": {
    "@11ty/eleventy": "^3.1.2",
    "@lhci/cli": "^0.15.1",
    "lighthouse": "^13.4.0",
    "linkinator": "^8.0.2",
    "markdownlint-cli": "^0.49.1",
    "oxfmt": "^0.64.0",
    "oxlint": "^1.74.0",
    "pour-cli": "^0.1.0"
  },
  "dependencies": {
    "markdown-it-footnote": "^4.0.0",
    "markdown-it-github-alerts": "^1.0.1"
  }
}
