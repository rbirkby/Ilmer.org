{
  "name": "ilmer-org",
  "version": "1.0.0",
  "description": "Ilmer Past - local history website",
  "private": true,
  "scripts": {
    "start": "npx @11ty/eleventy --config=.eleventy.ts --serve",
    "build": "npx @11ty/eleventy --config=.eleventy.ts",
    "format": "oxfmt --write .",
    "format-check": "oxfmt --check .",
    "lint": "oxlint && markdownlint --ignore node_modules '**/*.md' --config .markdownlintrc.json --fix",
    "lint-check": "oxlint && markdownlint --ignore node_modules '**/*.md' --config .markdownlintrc.json",
    "lint:events": "node scripts/check-events.ts",
    "validate:schema": "node scripts/validate-schema.ts",
    "link-check": "linkinator _site --recurse --verbosity error --status-code '401:warn' --status-code '403:warn' --status-code '429:warn'",
    "link-check:internal": "node scripts/check-links-internal.ts _site",
    "a11y": "node scripts/check-a11y-pour.ts _site",
    "a11y:report": "pour report https://www.ilmer.org/ --max 700 --same-host --report reports/a11y-report.html",
    "lighthouse": "lhci autorun",
    "typecheck": "tsc --noEmit",
    "test:unit": "node --test 'plugins/**/*.test.ts' 'tests/**/*.test.ts'",
    "test": "node --run typecheck && node --run test:unit && node --run format-check && node --run lint-check && node --run validate:schema && node --run lint:events && node --run build && node --run link-check:internal"
  },
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "keywords": [],
  "author": "Richard Birkby <rbirkby@gmail.com>",
  "license": "MIT",
  "devDependencies": {
    "@11ty/eleventy": "^3.1.2",
    "@lhci/cli": "^0.15.1",
    "@types/markdown-it-footnote": "^3.0.4",
    "@types/node": "^26.4.1",
    "ajv": "^8.20.0",
    "lighthouse": "^13.4.0",
    "linkinator": "^8.0.2",
    "markdownlint-cli": "^0.49.1",
    "oxfmt": "^0.65.0",
    "oxlint": "^1.74.0",
    "pour-cli": "^0.2.1",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "markdown-it-footnote": "^4.0.0",
    "markdown-it-github-alerts": "^1.0.1"
  }
}
