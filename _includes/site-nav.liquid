<nav>
  <a href="/map">Location</a>
  <a href="/newsroom">News</a>
  <a href="/about">About</a>
  <button
    type="button"
    id="open-search"
    class="search-link">
    Search
    {% render "icons/search.liquid" %}
  </button>
</nav>

<search-modal-snippet
  api-url="https://search.ilmer.org/"
  placeholder="Search Ilmer Past…"
  hide-branding="true"></search-modal-snippet>

<script>
  const searchModal = document.querySelector('search-modal-snippet');
  searchModal?.addEventListener('ready', () => {
    // The Cloudflare snippet manages aria-expanded and results, but its input
    // needs the combobox role for that state to be exposed to assistive tech.
    searchModal.shadowRoot?.querySelector('input[aria-expanded]')?.setAttribute('role', 'combobox');
  });
  document.querySelector('#open-search')?.addEventListener('click', () => searchModal?.open());
</script>
