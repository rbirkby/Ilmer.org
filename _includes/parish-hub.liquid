{% render "head"
  , content: content
  , lightbox: lightbox
  , layout: layout
  , script: script
  , site: site
  , url: url
  , title: title
  , description: description
  , tags: tags
  , image: image %}

{% render "site-header" %}

<main
  class="archive"
  {% if image %}
  style="--hero-image: url('{{ image | sitePath }}')"
  {% endif %}>
  <section class="archive-hero">
    <div class="archive-hero__text">
      {% render "breadcrumb.liquid"
        , ancestorCrumb1: ancestorCrumb1
        , ancestorCrumb2: ancestorCrumb2
        , breadcrumbUseDate: breadcrumbUseDate
        , page: page
        , title: title %}
      <h1>{{ title }}</h1>
      <p class="archive-hero__meta">{{ placeName }} &middot; {{ subtitle }}</p>
      {% render "archive-flourish.liquid" %}
      <p class="archive-hero__description">{{ description }}{{ content | renderMarkdownInline }}</p>
    </div>
  </section>

  <div class="archive-links">
    {% render "archive-link-card.liquid"
      , modifier: "council"
      , icon: "building"
      , heading: "Parish Council Minutes"
      , description: "The official record of council business, decisions and local administration."
      , archiveCollection: collections.minutes
      , href: "/parish/parishcouncil/" %}

    {% render "archive-link-card.liquid"
      , modifier: "meeting"
      , icon: "users"
      , heading: "Parish Meeting Minutes"
      , description: "Historic minutes of parish meetings and wider community discussion."
      , archiveCollection: collections.parishmeetings
      , href: "/parish/parishmeeting/" %}

    {% render "archive-link-card.liquid"
      , modifier: "ilmer-meeting"
      , icon: "book"
      , heading: "Ilmer Parish Meeting Minutes"
      , description: "Historic minutes of Ilmer's own parish meetings, before the parish merged with Longwick."
      , archiveCollection: collections.ilmerparishmeetings
      , href: "/parish/ilmerparishmeeting/" %}

    {% render "archive-link-card.liquid"
      , modifier: "vestry-meeting"
      , icon: "church"
      , heading: "Vestry Meeting Minutes"
      , description: "Minutes of the parish vestry."
      , archiveCollection: collections.vestrymeetings
      , href: "/parish/vestrymeeting/" %}

    {% render "archive-link-card.liquid"
      , modifier: "overseers"
      , icon: "document"
      , heading: "Overseers and Surveyors"
      , description: "The parish officials who cared for the poor and maintained the highways before councils existed."
      , dateRange: "1736&ndash;1868"
      , href: "/parish/overseers/" %}

    {% render "archive-link-card.liquid"
      , modifier: "councillors"
      , icon: "user"
      , heading: "Ilmer Parish Councillors"
      , description: "The councillors, constables and overseers of Ilmer, before the parish merged with Longwick."
      , dateRange: "1894&ndash;1935"
      , href: "/parish/councillors/" %}
  </div>

</main>
{% render "footer" %}