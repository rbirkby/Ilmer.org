{% include "head" %}

{% include "site-header" %}
{%- assign councilColl = collections.minutes -%}
{%- assign meetingColl = collections.parishmeetings -%}
{%- assign ilmerMeetingColl = collections.ilmerparishmeetings -%}
{%- assign councilFirst = councilColl | first -%}
{%- assign councilLast = councilColl | last -%}
{%- assign meetingFirst = meetingColl | first -%}
{%- assign meetingLast = meetingColl | last -%}
{%- assign ilmerMeetingFirst = ilmerMeetingColl | first -%}
{%- assign ilmerMeetingLast = ilmerMeetingColl | last -%}

<main
  class="archive"
  {% if image %}
  style="--hero-image: url('{{ image | sitePath }}')"
  {% endif %}>
  <section class="archive-hero">
    <div class="archive-hero__text">
      {% include "breadcrumb.liquid" %}
      <h1>{{ title }}</h1>
      <p class="archive-hero__meta">{{ placeName }} &middot; {{ subtitle }}</p>
      {% include "archive-flourish.liquid" %}
      <p class="archive-hero__description">{{ description }}{{ content | renderMarkdownInline }}</p>
    </div>
  </section>

  <div class="archive-links">
    <article class="archive-card archive-link-card archive-link-card--council">
      <span class="archive-link-card__icon">
        <svg
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.6"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true">
          <path d="M6 21V10l6-5 6 5v11"></path>
          <path d="M4 21h16"></path>
          <path d="M10 21v-6h4v6"></path>
          <path d="M12 5V2h3"></path>
        </svg>
      </span>
      <div class="archive-card__heading">
        <h2>Parish Council Minutes</h2>
        {% include "archive-flourish.liquid"
          , small: true %}
      </div>
      <p class="archive-link-card__description">The official record of council business, decisions and local administration.</p>
      <p class="archive-link-card__dates">
        <svg
          class="archive-icon"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.6"
          aria-hidden="true">
          <rect
            x="3.5"
            y="5"
            width="17"
            height="16"
            rx="2"></rect>
          <path d="M3.5 9.5h17M8 3v4M16 3v4"></path>
        </svg>
        {{ councilFirst.date | date: "%Y" }}&ndash;{{ councilLast.date | date: "%Y" }}</p>
      <a class="archive-link-card__cta" href="/parish/parishcouncil/">Explore archive
        <span aria-hidden="true">&rarr;</span>
      </a>
    </article>

    <article class="archive-card archive-link-card archive-link-card--meeting">
      <span class="archive-link-card__icon">
        <svg
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.6"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true">
          <circle
            cx="8.5"
            cy="8"
            r="2.5"></circle>
          <circle
            cx="16"
            cy="9"
            r="2"></circle>
          <path d="M3.5 19v-1.5A3.5 3.5 0 0 1 7 14h3a3.5 3.5 0 0 1 3.5 3.5V19M13.5 14.3A3 3 0 0 1 19 16.5V19"></path>
        </svg>
      </span>
      <div class="archive-card__heading">
        <h2>Parish Meeting Minutes</h2>
        {% include "archive-flourish.liquid"
          , small: true %}
      </div>
      <p class="archive-link-card__description">Historic minutes of parish meetings and wider community discussion.</p>
      <p class="archive-link-card__dates">
        <svg
          class="archive-icon"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.6"
          aria-hidden="true">
          <rect
            x="3.5"
            y="5"
            width="17"
            height="16"
            rx="2"></rect>
          <path d="M3.5 9.5h17M8 3v4M16 3v4"></path>
        </svg>
        {{ meetingFirst.date | date: "%Y" }}&ndash;{{ meetingLast.date | date: "%Y" }}</p>
      <a class="archive-link-card__cta" href="/parish/parishmeeting/">Explore archive
        <span aria-hidden="true">&rarr;</span>
      </a>
    </article>

    <article class="archive-card archive-link-card archive-link-card--ilmer-meeting">
      <span class="archive-link-card__icon">
        <svg
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.6"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true">
          <path d="M4 5.5A2.5 2.5 0 0 1 6.5 3H12v16H6.5A2.5 2.5 0 0 0 4 21.5z"></path>
          <path d="M20 5.5A2.5 2.5 0 0 0 17.5 3H12v16h5.5A2.5 2.5 0 0 1 20 21.5z"></path>
        </svg>
      </span>
      <div class="archive-card__heading">
        <h2>Ilmer Parish Meeting Minutes</h2>
        {% include "archive-flourish.liquid"
          , small: true %}
      </div>
      <p class="archive-link-card__description">Historic minutes of Ilmer's own parish meetings, before the parish merged with Longwick.</p>
      {%- if ilmerMeetingFirst %}
      <p class="archive-link-card__dates">
        <svg
          class="archive-icon"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.6"
          aria-hidden="true">
          <rect
            x="3.5"
            y="5"
            width="17"
            height="16"
            rx="2"></rect>
          <path d="M3.5 9.5h17M8 3v4M16 3v4"></path>
        </svg>
        {{ ilmerMeetingFirst.date | date: "%Y" }}&ndash;{{ ilmerMeetingLast.date | date: "%Y" }}</p>
      {%- endif %}
      <a class="archive-link-card__cta" href="/parish/ilmerparishmeeting/">Explore archive
        <span aria-hidden="true">&rarr;</span>
      </a>
    </article>

    <article class="archive-card archive-link-card archive-link-card--overseers">
      <span class="archive-link-card__icon">
        <svg
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.6"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true">
          <path d="M6 3.5h9.5L19 7v13.5H6z"></path>
          <path d="M15.5 3.5V7H19"></path>
          <path d="M9 11.5h6M9 14.5h6M9 17.5h3.5"></path>
        </svg>
      </span>
      <div class="archive-card__heading">
        <h2>Overseers and Surveyors</h2>
        {% include "archive-flourish.liquid"
          , small: true %}
      </div>
      <p class="archive-link-card__description">The parish officials who cared for the poor and maintained the highways before councils existed.</p>
      <p class="archive-link-card__dates">
        <svg
          class="archive-icon"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.6"
          aria-hidden="true">
          <rect
            x="3.5"
            y="5"
            width="17"
            height="16"
            rx="2"></rect>
          <path d="M3.5 9.5h17M8 3v4M16 3v4"></path>
        </svg>
        1736&ndash;1868</p>
      <a class="archive-link-card__cta" href="/parish/overseers/">Explore archive
        <span aria-hidden="true">&rarr;</span>
      </a>
    </article>

    <article class="archive-card archive-link-card archive-link-card--councillors">
      <span class="archive-link-card__icon">
        <svg
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.6"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true">
          <circle
            cx="12"
            cy="8"
            r="3.2"></circle>
          <path d="M5 20v-1.5A5.5 5.5 0 0 1 10.5 13h3A5.5 5.5 0 0 1 19 18.5V20"></path>
        </svg>
      </span>
      <div class="archive-card__heading">
        <h2>Ilmer Parish Councillors</h2>
        {% include "archive-flourish.liquid"
          , small: true %}
      </div>
      <p class="archive-link-card__description">The councillors, constables and overseers of Ilmer, before the parish merged with Longwick.</p>
      <p class="archive-link-card__dates">
        <svg
          class="archive-icon"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.6"
          aria-hidden="true">
          <rect
            x="3.5"
            y="5"
            width="17"
            height="16"
            rx="2"></rect>
          <path d="M3.5 9.5h17M8 3v4M16 3v4"></path>
        </svg>
        1894&ndash;1935</p>
      <a class="archive-link-card__cta" href="/parish/councillors/">Explore archive
        <span aria-hidden="true">&rarr;</span>
      </a>
    </article>
  </div>

</main>
{% include "footer" %}
