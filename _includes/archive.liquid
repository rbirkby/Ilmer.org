{% render "head"
  , content: content
  , lightbox: lightbox
  , layout: layout
  , script: script
  , site: site
  , url: url
  , title: title
  , description: description
  , tags: tags
  , image: image %}

{% render "site-header" %}
{%- assign itemSingular = itemNounSingular | default: "minute" -%}
{%- assign itemPlural = itemNounPlural | default: "minutes" -%}
{%- assign eventSingular = eventNounSingular | default: "meeting" -%}
{%- assign eventPlural = eventNounPlural | default: "meetings" -%}
{%- assign coll = collections[collectionName] -%}
{%- assign archiveData = coll | archiveByDecade -%}
{%- assign subjectTags = coll | archiveSubjectTags: collectionName -%}
{%- assign firstItem = coll | first -%}
{%- assign lastItem = coll | last -%}
{%- if firstItem -%}
  {%- assign startYear = firstItem.date | date: "%Y" -%}
  {%- assign endYear = lastItem.date | date: "%Y" -%}
{%- endif -%}

{%- assign featuredItem = nil -%}
{%- unless hideFeatured -%}
  {%- if featured -%}
    {%- for item in coll -%}
      {%- assign itemDate = item.date | date: "%Y-%m-%d" -%}
      {%- if itemDate == featured -%}
        {%- assign featuredItem = item -%}
      {%- endif -%}
    {%- endfor -%}
  {%- endif -%}
  {%- unless featuredItem -%}
    {%- assign featuredItem = firstItem -%}
  {%- endunless -%}
{%- endunless -%}
{%- if featuredItem -%}
  {%- assign featuredExcerpt = featuredItem.templateContent | strip_html | strip_newlines | truncate: 240 -%}
  {%- assign featuredHeadlineParts = featuredItem.templateContent | split: 'margin-note__text">' -%}
  {%- if featuredHeadlineParts.size > 1 -%}
    {%- assign featuredHeadline = featuredHeadlineParts[1] | split: '</span>' | first -%}
    {%- assign featuredExcerpt = featuredExcerpt | remove_first: featuredHeadline | strip -%}
  {%- endif -%}
{%- endif -%}

<main
  class="archive"
  {% if image %}
  style="--hero-image: url('{{ image | sitePath }}')"
  {% endif %}>
  <section class="archive-hero">
    <div class="archive-hero__text">
      {% render "breadcrumb.liquid"
        , ancestorCrumb1: ancestorCrumb1
        , ancestorCrumb2: ancestorCrumb2
        , breadcrumbUseDate: breadcrumbUseDate
        , page: page
        , title: title %}
      <h1>{{ title }}</h1>
      <p class="archive-hero__meta">{{ placeName }}{% if startYear %}
          &middot; {{ startYear }}&ndash;{{ endYear }}{% endif %}
      </p>
      {% render "archive-flourish.liquid" %}
      <p class="archive-hero__description">{{ description | renderMarkdownInline }}</p>
      {% unless hideSearch %}
        <form
          class="archive-search"
          role="search"
          aria-label="Search the {{ itemPlural }}">
          <label for="archive-search-input" class="sr-only">Search the {{ itemPlural }}</label>
          <input
            id="archive-search-input"
            type="search"
            name="q"
            placeholder="Search the {{ itemPlural }}">
          <button type="submit">Search</button>
        </form>
      {% endunless %}
    </div>
  </section>

  <div class="archive-panels">
    {% if featuredItem %}
      <section class="archive-card archive-featured" aria-labelledby="from-the-minutes-heading">
        <div class="archive-card__heading">
          <h2 id="from-the-minutes-heading">from the {{ itemPlural }}</h2>
          {% render "archive-flourish.liquid"
            , small: true %}
        </div>
        <p class="archive-featured__date">
          {% render "icons/calendar.liquid" %}
          {{ featuredItem.date | date: "%-d %B %Y" }}
        </p>
        {% if featuredHeadline %}
          <p class="archive-featured__title">{{ featuredHeadline }}</p>
        {% endif %}
        <p class="archive-featured__quote">&ldquo;{{ featuredExcerpt }}&hellip;&rdquo;</p>
        <a class="archive-featured__link" href="{{ featuredItem.url }}">Read the full {{ itemSingular }}
          <span aria-hidden="true">&rarr;</span>
        </a>
      </section>
    {% endif %}

    <section class="archive-card archive-browse" aria-labelledby="browse-heading">
      <div class="archive-card__heading">
        <h2 id="browse-heading">Browse the archive</h2>
        <span class="archive-browse__total">{{ coll.size }} {% if coll.size != 1 %}{{ itemPlural }}{% else %}{{ itemSingular }}{% endif %}
        </span>
      </div>
      <div class="archive-decades">
        {% for decadeGroup in archiveData %}
          <div class="archive-decade">
            <input
              type="checkbox"
              id="decade-{{ collectionName }}-{{ decadeGroup.decade }}"
              class="archive-decade__toggle"
              hidden>
            <label class="archive-decade__summary" for="decade-{{ collectionName }}-{{ decadeGroup.decade }}">
              <span class="archive-decade__label">
                {% render "icons/calendar.liquid" %}
                {{ decadeGroup.decade }}s
              </span>
              <span class="archive-decade__count">{{ decadeGroup.totalCount }} {% if decadeGroup.totalCount != 1 %}{{ itemPlural }}{% else %}{{ itemSingular }}{% endif %}
              </span>
              {% render "icons/chevron-down.liquid" %}
            </label>
            <div class="archive-years">
              {% for y in decadeGroup.years %}
                <details class="archive-year">
                  <summary>
                    <span>{{ y.year }}</span>
                    <span class="archive-year__count">{{ y.count }} {% if y.count != 1 %}{{ eventPlural }}{% else %}{{ eventSingular }}{% endif %}
                    </span>
                  </summary>
                  <ul class="archive-year__list">
                    {% for it in y.items %}
                      <li>
                        <a href="{{ it.url }}">{% if itemsAreAnnual %}{{ it.title }}{% else %}{{ it.date | date: "%-d %b" }}{% endif %}</a>
                      </li>
                    {% endfor %}
                  </ul>
                </details>
              {% endfor %}
            </div>
          </div>
        {% else %}
          <p class="archive-browse__empty">{{ itemPlural | capitalize }} will appear here as they are added to the archive.</p>
        {% endfor %}
      </div>
    </section>
  </div>

  {% if subjectTags.size > 0 %}
    <section class="archive-card archive-subjects" aria-labelledby="subjects-heading">
      <div class="archive-card__heading">
        <h2 id="subjects-heading">Explore by subject</h2>
      </div>
      <div class="archive-subjects__list">
        {% for s in subjectTags %}
          <a class="subject-pill" href="{{ subjectBasePath }}{{ s.tag }}/">
            <span class="subject-pill__icon">{{ s.tag | subjectIcon }}</span>
            {{ s.tag | subjectLabel }}
          </a>
        {% endfor %}
      </div>
    </section>
  {% endif %}
</main>
{% render "footer" %}