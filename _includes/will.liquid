{% render "head"
  , content: content
  , lightbox: lightbox
  , layout: layout
  , script: script
  , site: site
  , url: url
  , title: title
  , description: description
  , tags: tags
  , image: image %}

{% render "site-header" %}
<main>
  <section class="article">
    {% render "breadcrumb.liquid"
      , ancestorCrumb1: ancestorCrumb1
      , ancestorCrumb2: ancestorCrumb2
      , breadcrumbUseDate: breadcrumbUseDate
      , page: page
      , title: title %}

    <h1>{{ title }}</h1>
    <p class="will-meta">{{ description }}</p>

    {% if script == "secretary-hand" or script == "round-hand" %}
      <label class="font-toggle">
        <input
          type="checkbox"
          id="fontToggle"
          onchange="toggleFont(this)">
        <span class="toggle-label toggle-label--secretary">
          {% case script %}
            {% when "secretary-hand" %}
              Secretary Hand
            {% when "round-hand" %}
              Round Hand
            {% else %}
              Unknown Script
          {% endcase %}
        </span>
        <span class="toggle-pill"></span>
        <span class="toggle-label toggle-label--modern">Modern script</span>
      </label>
    {% endif %}

    <div class="will-body" data-script="{{ script | escape }}">
      {{ content }}
    </div>


    {% if explanation %}
      <p class="will-explanation">
        <a href="{{ explanation }}">Modern-English summary</a>
      </p>
    {% endif %}

  </section>
</main>

<script>
  function toggleFont(checkbox) {
    const body = document.querySelector('.will-body');
    body.style.opacity = '0';
    setTimeout(() => {
      body.classList.toggle('modern', checkbox.checked);
      body.style.opacity = '1';
    }, 100);
  }
</script>
{% render "footer" %}