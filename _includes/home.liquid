{% include "head" %}

<header>
  <div class="container">
    <div class="mast">
      <a href="/">Ilmer Past</a>
    </div>
    <div class="banner">
      <h1>Ilmer Past</h1>
      <p>One historic village through time</p>
    </div>
    {% include "site-nav" %}
  </div>
</header>
<main>
  <section>
    {% assign homePosts = collections.post | sortByUrlOrder: site.homePostOrder %}
    {% for post in homePosts %}
      <article>
        <a href="{{ post.url }}">
          <header>
            {% if post.data.image %}
              <img src="{{ post.data.image | sitePath }}" alt="{{ post.data.title }}">
            {% endif %}
          </header>
          <div class="card-text">
            <h2>{{ post.data.title }}</h2>
            <p>{{ post.data.description }}</p>
          </div>
          <span class="card-arrow" aria-hidden="true">→</span>
        </a>
      </article>
    {% endfor %}
  </section>
</main>
{% include "footer" %}
