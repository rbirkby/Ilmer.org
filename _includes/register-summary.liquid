{%- assign stats = records | yearBarChart: yearKey -%}
{%- if stats -%}
  <dl class="register-summary">
    <div class="register-summary__stat">
      <dt>Total {{ label }}</dt>
      <dd>{{ stats.total }}</dd>
    </div>
    <div class="register-summary__stat">
      <dt>Years covered</dt>
      <dd>{{ stats.minYear }}&ndash;{{ stats.maxYear }}</dd>
    </div>
    <div class="register-summary__stat">
      <dt>Average per year</dt>
      <dd>{{ stats.average }}</dd>
    </div>
    <div class="register-summary__stat">
      <dt>Busiest year</dt>
      <dd>{{ stats.busiestYear }} <span class="register-summary__substat">({{ stats.maxCount }})</span></dd>
    </div>
  </dl>
{%- endif -%}
