{% include "head" %}

{% include "site-header" %}
<main{% if useArchiveCss %} class="archive"{% endif %}>
  {% if image %}
    <figure>
      <img src="{{ image | sitePath }}" alt="{{ title }}">
    </figure>
  {% endif %}
  <section class="article" data-lightbox-all="{{ lightbox | default: false }}">

    {% include "breadcrumb.liquid" %}

    {% if headerUseDate %}
      <h1 class="minute-heading">{{ ancestorCrumb2.label }}</h1>
      <p class="archive-subheading">{{ page.date | date: "%A, %-d %B %Y" }}</p>
    {% elsif headerUseSubject %}
      <h1 class="minute-heading">{{ subjectHeading }}</h1>
      <p class="archive-subheading">{{ ancestorCrumb2.label }} &middot; Subject archive</p>
      {% include "archive-flourish.liquid" %}
    {% else %}
      <h1{% if useArchiveCss %} class="minute-heading"{% endif %}>{{ title }}</h1>

      <p>{{ description }}</p>
    {% endif %}

    {{ content }}

    {% if headerUseDate %}
      {%- assign adjacent = collections[collectionName] | adjacentItem: page.url -%}
      <nav class="minute-pager" aria-label="Minute navigation">
        {% if adjacent.previous %}
          <a class="minute-pager__link minute-pager__link--prev" href="{{ adjacent.previous.url }}">
            <span aria-hidden="true">&larr;</span> Previous Minute
          </a>
        {% endif %}
        {% if adjacent.next %}
          <a class="minute-pager__link minute-pager__link--next" href="{{ adjacent.next.url }}">
            Next Minute <span aria-hidden="true">&rarr;</span>
          </a>
        {% endif %}
      </nav>
    {% endif %}
  </section>

  <div id="image-lightbox" popover>
    <button
      popovertarget="image-lightbox"
      class="lightbox-close"
      aria-label="Close lightbox">&times;</button>
    <img id="lightbox-image" alt="" />
    <p id="lightbox-caption"></p>
  </div>
</main>
{% include "footer" %}
