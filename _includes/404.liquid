{% render "head"
  , content: content
  , lightbox: lightbox
  , layout: layout
  , script: script
  , site: site
  , url: url
  , title: title
  , description: description
  , tags: tags
  , image: image %}

{% render "site-header" %}
<main class="archive">
  <section class="article">
    {% render "breadcrumb.liquid"
      , ancestorCrumb1: ancestorCrumb1
      , ancestorCrumb2: ancestorCrumb2
      , breadcrumbUseDate: breadcrumbUseDate
      , page: page
      , title: title %}

    <h1 class="minute-heading">{{ title }}</h1>
    <p>
      {% if description %}
        {{ description }}
      {% else %}
        {{ tagline }}{% endif %}
    </p>

    {{ content }}
  </section>
</main>
{% render "footer" %}