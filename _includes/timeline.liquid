{% render "head"
  , content: content
  , lightbox: lightbox
  , layout: layout
  , script: script
  , site: site
  , url: url
  , title: title
  , description: description
  , tags: tags
  , image: image %}

{% render "site-header" %}
<main>
  <section>
    {% render "breadcrumb.liquid"
      , ancestorCrumb1: ancestorCrumb1
      , ancestorCrumb2: ancestorCrumb2
      , breadcrumbUseDate: breadcrumbUseDate
      , page: page
      , title: title %}
    <h1>{{ title }}</h1>

    <p>{{ description }}</p>

    {{ content }}
  </section>
</main>
{% render "footer" %}