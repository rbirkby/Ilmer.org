{% render "head"
  , content: content
  , lightbox: lightbox
  , layout: layout
  , script: script
  , site: site
  , url: url
  , title: title
  , description: description
  , tags: tags
  , image: image %}

{% render "site-header" %}
<main class="archive timeline">
  <section class="archive-hero">
    <div class="archive-hero__text">
      {% render "breadcrumb.liquid"
        , ancestorCrumb1: ancestorCrumb1
        , ancestorCrumb2: ancestorCrumb2
        , breadcrumbUseDate: breadcrumbUseDate
        , page: page
        , title: title %}
      <h1>{{ title }}</h1>
      {% render "archive-flourish.liquid" %}
      <p class="archive-hero__description">{{ description }}</p>
    </div>
  </section>

  <section class="timeline-body">
    {{ content }}
  </section>
</main>
{% render "footer" %}
