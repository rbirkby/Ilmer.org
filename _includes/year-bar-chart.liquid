{%- assign chart = records | yearBarChart: yearKey -%}
{%- assign decadeChart = records | yearBarChart: yearKey, 10 -%}
{%- if chart -%}
  <figure class="year-bar-chart-figure">
    {%- comment -%}
      The chart's title doubles as its grouping control: picking a period
      swaps which panel below is shown, with no script involved (see
      .year-bar-chart-figure:has(...) in archive.css).
    {%- endcomment -%}
    <label class="sr-only" for="chart-grouping-{{ label }}">Group {{ label }} by</label>
    <select
      class="year-bar-chart-figure__grouping"
      id="chart-grouping-{{ label }}"
      name="chart-grouping-{{ label }}">
      <option value="year" selected>{{ label | capitalize }} by year</option>
      <option value="decade">{{ label | capitalize }} by decade</option>
    </select>
    <div class="year-bar-chart-figure__panels">
      <div class="year-bar-chart-figure__panel" data-grouping="year">
        {% render "year-bar-chart-svg.liquid", chart: chart, label: label, period: "year" %}
      </div>
      <div class="year-bar-chart-figure__panel" data-grouping="decade">
        {% render "year-bar-chart-svg.liquid", chart: decadeChart, label: label, period: "decade" %}
      </div>
    </div>
    <figcaption>{{ chart.total }} {{ label }}, {{ chart.minYear }}&ndash;{{ chart.maxYear }}.
      <a href="{{ href }}">View the full register</a>.</figcaption>
  </figure>
{%- endif -%}
