---
layout: timeline
title: 'Timeline'
description: 'A detailed timeline of the history of Ilmer from 1066 to present-day.'
category: history
tags: [post]
image: images/timeline.png
---

<script type="module">
  import { initImageLightbox } from '{{ "/assets/js/image-lightbox.js" | cacheBust }}';

  document.getElementById('timeline-filter').addEventListener('change', function() {
    const category = this.value;
    document.querySelectorAll('.timeline-item').forEach(item => {
      const categories = JSON.parse(item.getAttribute('data-categories'));
      item.classList.toggle('hidden', category !== '' && !categories.includes(category));
    });
  });

  // A linked event hidden by the category filter can't be scrolled to, so clear the filter first
  function revealTarget() {
    const target = document.getElementById(decodeURIComponent(location.hash.slice(1)));
    if (target?.classList.contains('hidden')) {
      const filter = document.getElementById('timeline-filter');
      filter.value = '';
      filter.dispatchEvent(new Event('change'));
      target.scrollIntoView();
    }
  }
  addEventListener('hashchange', revealTarget);
  revealTarget();

  document.getElementById('scroll-to-top').addEventListener('click', function() {
    window.scrollTo({ top: 0, behavior: 'smooth' });
  });

  document.querySelectorAll('.date[data-regnal-date]').forEach(date => {
    const calendarDate = date.textContent;
    const regnalDate = date.dataset.regnalDate;
    date.setAttribute('role', 'button');
    date.tabIndex = 0;
    date.setAttribute('aria-label', `${calendarDate}: show regnal year`);

    function toggleDate() {
      const showRegnal = date.textContent === calendarDate;
      date.textContent = showRegnal ? regnalDate : calendarDate;
      date.setAttribute('aria-label', `${date.textContent}: show ${showRegnal ? 'calendar date' : 'regnal year'}`);
    }
    date.addEventListener('click', toggleDate);
    date.addEventListener('keydown', event => {
      if (event.key === 'Enter' || event.key === ' ') {
        event.preventDefault();
        toggleDate();
      }
    });
  });

  initImageLightbox({ triggerSelector: '.timeline-image-link' });
</script>

<button id="scroll-to-top" title="Click to scroll back to the top of the page">
  ▲
</button>


<script type="module" src="{{ '/assets/js/anniversaries.js' | cacheBust }}"></script>
<timeline-anniversaries>
  {% assign filteredEvents = historicalEvents | where_exp: "event", "event.hidden != true" %}
  <script type="application/json" data-events>
    [{% for event in filteredEvents %}{"id":{{ event.date | append: " " | append: event.title | slugify | jsonify }},"date":{{ event.date | jsonify }},"title":{{ event.title | jsonify }}}{% unless forloop.last %},{% endunless %}{% endfor %}]
  </script>
</timeline-anniversaries>

{% assign labels = historicalEvents | uniqueLabels %}
<label class="timeline-filter-label" for="timeline-filter">Filter events by category</label>
<select id="timeline-filter" name="filter">
  <option value="">
    <span class="label-name">All Events</span>
    <span class="label-count">{{ historicalEvents | size }}</span>
  </option>
  {% for label in labels %}
    <option value="{{ label.label }}">
      <span class="label-name">{{ label.label }}</span>
      <span class="label-count">{{ label.count }}</span>
    </option>
  {% endfor %}
</select>

<!-- Image lightbox popover -->
<div id="image-lightbox" popover>
  <button
    popovertarget="image-lightbox"
    class="lightbox-close"
    aria-label="Close lightbox">&times;</button>
  <img id="lightbox-image" alt="" />
  <p id="lightbox-caption"></p>
</div>

<div id="timeline-container">
  {% for event in historicalEvents %}
    {% unless event.hidden %}
      <div
        class="timeline-item"
        id="{{ event.date | append: " " | append: event.title | slugify }}"
        data-categories='{{ event.labels | jsonify }}'>
        <div class="timeline-icon"></div>
        <div class="timeline-content">
          <h2>
            {% assign regnalDate = event.date | regnalYears %}
            <span class="date"{% if regnalDate != empty %} data-regnal-date="{{ regnalDate | escape }}"{% endif %}>{{ event.date }}</span>
            {{ event.title }}</h2>
          {% if event.smallimage %}
            <a
              href="{{event.image}}"
              class="timeline-image-link"
              data-full-image="{{event.image}}"
              data-caption="{{ event.title }}"><img
                src="{{ event.smallimage }}"
                loading="lazy"
                alt="{{ event.title }}"></a>
          {% elsif event.image %}
            <a
              href="{{event.image}}"
              class="timeline-image-link"
              data-full-image="{{event.image}}"
              data-caption="{{ event.title }}"><img
                src="{{ event.image }}"
                loading="lazy"
                alt="{{ event.title }}"></a>
          {% endif %}

          {{ event.description | renderContent: "md" }}
          {% if event.references != empty %}
            <span class="reference">Source(s): {{ event.references | join: ' <br> ' | renderMarkdownInline }}</span>
          {% endif %}
        </div>
      </div>
    {% endunless %}
  {% endfor %}

</div>
